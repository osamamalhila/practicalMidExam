<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/details_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_background"
    tools:context=".ArtworkDetailsActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Screen Header Title -->
        <TextView
            android:id="@+id/tv_details_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/artwork_details"
            android:textColor="#2D2825"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Artwork Image Preview Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_details_artwork"
            android:layout_width="0dp"
            android:layout_height="280dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="2dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_details_header">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/iv_details_artwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Artwork Image Details"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/artwork_stellar_deaths" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Detailed Info Card -->
        <LinearLayout
            android:id="@+id/layout_details_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/info_card_bg"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_details_artwork">

            <!-- Title -->
            <TextView
                android:id="@+id/tv_details_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_title"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Deep Field Stellar Deaths" />

            <!-- Artist Name -->
            <TextView
                android:id="@+id/tv_details_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_subtitle"
                android:textSize="17sp"
                tools:text="Artist: Smacs Carin" />

            <!-- Creation Year -->
            <TextView
                android:id="@+id/tv_details_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_subtitle"
                android:textSize="17sp"
                tools:text="Creation Year: 2021" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#E5D3C8" />

            <!-- Description -->
            <TextView
                android:id="@+id/tv_details_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textColor="#3D3531"
                android:textSize="15sp"
                tools:text="A high-resolution deep field view showing stellar death nebulae." />

        </LinearLayout>

        <!-- Buttons Section (Visit Website Implicit Intent & Return Explicit Intent) -->
        <LinearLayout
            android:id="@+id/layout_details_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_details_info"
            app:layout_constraintVertical_bias="1.0">

            <!-- Implicit Intent Button: Visit Website -->
            <android.widget.Button
                android:id="@+id/btn_visit_website"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_selector"
                android:enabled="true"
                android:text="@string/btn_visit_website"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Return Button: Back to Main Activity -->
            <android.widget.Button
                android:id="@+id/btn_return"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_selector"
                android:enabled="true"
                android:text="@string/btn_return"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
